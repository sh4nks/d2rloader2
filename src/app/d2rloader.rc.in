#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @CMAKE_PROJECT_VERSION_MAJOR@,@CMAKE_PROJECT_VERSION_MINOR@,@CMAKE_PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @CMAKE_PROJECT_VERSION_MAJOR@,@CMAKE_PROJECT_VERSION_MINOR@,@CMAKE_PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "someblocks"
            VALUE "FileDescription", "D2RLoader"
            VALUE "FileVersion", "@CMAKE_PROJECT_VERSION@"
            VALUE "InternalName", "d2rloader"
            VALUE "LegalCopyright", "Copyright (c) 2025 - 2026 Peter Justin"
            VALUE "OriginalFilename", "d2rloader.exe"
            VALUE "ProductName", "D2RLoader"
            VALUE "ProductVersion", "@CMAKE_PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
